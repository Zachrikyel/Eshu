<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Mismo lenguaje visual del mockup (marquesina + vitrina arcade).
         Todo en un solo lugar para no repetir colores sueltos por el código. -->
    <Color x:Key="BgBaseColor">#0B0E14</Color>
    <Color x:Key="BgPanelColor">#12161F</Color>
    <Color x:Key="BgChipColor">#181D28</Color>
    <Color x:Key="CyanColor">#2DE3C8</Color>
    <Color x:Key="AmberColor">#FFB84D</Color>
    <Color x:Key="GreenColor">#4ADE80</Color>
    <Color x:Key="WineColor">#B5637A</Color>
    <Color x:Key="TextPrimaryColor">#F2F4F7</Color>
    <Color x:Key="TextSecondaryColor">#8B94A8</Color>
    <Color x:Key="BorderColor">#2A2F3B</Color>

    <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBaseColor}"/>
    <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}"/>
    <SolidColorBrush x:Key="BgChipBrush" Color="{StaticResource BgChipColor}"/>
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}"/>
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}"/>
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="WineBrush" Color="{StaticResource WineColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource BorderColor}"/>

</ResourceDictionary>
